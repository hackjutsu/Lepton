{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lepton Rust Prototype",
  "version": "0.1.0",
  "identifier": "io.lepton.rust-prototype",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lepton \u00b7 Rust prototype",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
