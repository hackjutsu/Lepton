{
  "name": "lepton-rust-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node ../../node_modules/webpack/bin/webpack.js --mode production --config webpack.prototype.cjs && node legacy/copy-html.cjs",
    "start": "tauri dev",
    "package": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src index.html *.json src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src index.html *.json src-tauri/*.json src-tauri/capabilities/*.json",
    "test:ui:build": "tauri build --debug --no-bundle --features ui-tests --config src-tauri/tauri.ui-test.conf.json",
    "test:ui": "npm run test:ui:build && node tests/ui/smoke.mjs && node tests/ui/offline.mjs"
  },
  "_scriptNotes": {
    "start": "npm start: manual testing with a dedicated provider token. Rust debug builds outside UI tests use existing unencrypted file token storage without Keychain access, regardless of the saved storage preference. Login persists across restarts; logout clears the saved token. Release builds retain configured credential storage."
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/lang-rust": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "codemirror": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.0.0",
    "vite": "^7.0.0"
  }
}
